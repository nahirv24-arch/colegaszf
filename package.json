{
  "name": "zf-material-colegas",
  "private": true,
  "version": "0.5.0",
  "description": "Material para colegas — ZF Propiedades (React + TypeScript + Vite)",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "validar": "python scripts/validar_extraccion.py",
    "sb:migrar": "node scripts/supabase/migrar.mjs",
    "sb:importar": "node scripts/supabase/importar.mjs",
    "sb:admin": "node scripts/supabase/asignar_admin.mjs",
    "sb:exportar": "node scripts/supabase/exportar.mjs",
    "sb:pruebas": "node scripts/supabase/pruebas_seguridad.mjs",
    "sb:pruebas-panel": "node scripts/supabase/pruebas_panel.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.119.0",
    "jspdf": "^4.2.1",
    "jszip": "^3.10.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "supabase": "^3.1.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  },
  "engines": {
    "node": ">=22.22.0"
  }
}
